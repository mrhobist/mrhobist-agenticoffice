        <mxCell id="k-w2e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="k-w2s5" target="k-w2done"><mxGeometry relative="1" as="geometry"/></mxCell>
