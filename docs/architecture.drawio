          <mxGeometry x="1160" y="250" width="300" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="oe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="o-api" target="o-app"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="570" as="sourcePoint"/><mxPoint x="300" y="610" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="oe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="o-inf" target="o-app"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="570" as="sourcePoint"/><mxPoint x="860" y="610" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="oe3" value="DI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="o-api" target="o-inf"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="120" as="sourcePoint"/><mxPoint x="600" y="120" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="oe4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="o-app" target="o-dom"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="970" as="sourcePoint"/><mxPoint x="580" y="1000" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="oe5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="o-tests" target="o-api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="90"/><mxPoint x="300" y="90"/></Array></mxGeometry></mxCell>
