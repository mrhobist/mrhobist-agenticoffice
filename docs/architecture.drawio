        </mxCell>
        <mxCell id="k-w2s5" value="&lt;b&gt;Karar&lt;/b&gt;&lt;br&gt;review · manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
