        <!-- Tasarımlı akış -->
        <mxCell id="k-wf2" value="&lt;b&gt;İş akışı: tasarimli (Tasarımlı)&lt;/b&gt; — kullanıcıya dokunan yüzeyi olan işler; analizden sonra tasarımcı girer · handoffRole: organizer · maxReviewRounds: 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1290" height="150" as="geometry"/>
