        <mxCell id="t-ui-l" value="&lt;b&gt;Nuxt 4.2&lt;/b&gt; (SPA kabuğu, tek sayfa app.vue)&lt;br&gt;&lt;b&gt;Vue 3.5&lt;/b&gt; Composition API, &amp;lt;script setup&amp;gt;&lt;br&gt;&lt;b&gt;TypeScript 5.9&lt;/b&gt; + vue-tsc typecheck&lt;br&gt;&lt;b&gt;Canvas 2D&lt;/b&gt; — sprite tabanlı piksel ofis, kendi oyun döngüsü (world.ts)&lt;br&gt;&lt;b&gt;openapi-typescript 7&lt;/b&gt; — /openapi/v1.json → shared/types/api.ts (elle yazılmaz)&lt;br&gt;&lt;b&gt;EventSource&lt;/b&gt; (SSE) + fetch yoklama&lt;br&gt;&lt;b&gt;Ico.vue&lt;/b&gt; tek renkli SVG ikon seti&lt;br&gt;Sprite hattı: Python Pillow script → PNG atlas" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="135" width="360" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="t-net" value="&lt;b&gt;Backend — src/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="380" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="t-net-l" value="&lt;b&gt;.NET 10&lt;/b&gt; · C# · Minimal API · Onion (Domain / Application / Infrastructure / Api)&lt;br&gt;&lt;b&gt;Microsoft.AspNetCore.OpenApi&lt;/b&gt; + &lt;b&gt;Scalar&lt;/b&gt; (sözleşme /openapi/v1.json)&lt;br&gt;&lt;b&gt;JwtBearer&lt;/b&gt; — tek şema, rol claim'i&lt;br&gt;&lt;b&gt;Microsoft.Extensions.Http(.Resilience)&lt;/b&gt; — runtime istemcisi&lt;br&gt;&lt;b&gt;Serilog&lt;/b&gt; → dosya (GenericLog sözleşmesi)&lt;br&gt;&lt;b&gt;System.Threading.Channels&lt;/b&gt; — JobChannel / JobWorker (süreç içi kuyruk)&lt;br&gt;&lt;b&gt;Server-Sent Events&lt;/b&gt; — SceneEventBus&lt;br&gt;&lt;b&gt;Problem Details&lt;/b&gt; + errorCode&lt;br&gt;&lt;b&gt;xunit 2.9&lt;/b&gt; + coverlet — UnitTests · ServiceTests&lt;br&gt;Central Package Management (Directory.Packages.props), slnx" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="135" width="360" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="t-py" value="&lt;b&gt;LLM katmanı — runtime/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="100" width="380" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="t-py-l" value="&lt;b&gt;Python 3.12&lt;/b&gt; (runtime/.venv)&lt;br&gt;&lt;b&gt;FastAPI ≥0.120&lt;/b&gt; + &lt;b&gt;uvicorn&lt;/b&gt;&lt;br&gt;&lt;b&gt;pydantic 2&lt;/b&gt; — TurnRequest / TurnResponse sözleşmesi (camelCase alias)&lt;br&gt;&lt;b&gt;httpx&lt;/b&gt; — progressUrl geri çağrısı, OpenAI Responses API, limit ucu&lt;br&gt;&lt;b&gt;claude-agent-sdk ≥0.2&lt;/b&gt; — claude.exe oturumu üstünden ajan döngüsü + araçlar&lt;br&gt;&lt;b&gt;Codex CLI&lt;/b&gt; (npm @openai/codex) — codex exec --json&lt;br&gt;&lt;b&gt;pytest&lt;/b&gt; + pytest-asyncio + respx&lt;br&gt;Kimlik: CLI oturumu (OAuth) &lt;i&gt;veya&lt;/i&gt; API anahtarı (credentials.json)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="135" width="360" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="t-store" value="&lt;b&gt;Depolama — dosya tabanlı&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="380" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="t-store-l" value="&lt;b&gt;Markdown + YAML frontmatter&lt;/b&gt; — ajanlar, bilgi dosyaları&lt;br&gt;&lt;b&gt;JSON&lt;/b&gt; — iş akışları, projeler, sahne, ayarlar&lt;br&gt;&lt;b&gt;JSONL (append-only)&lt;/b&gt; — çalışma, faz, mesaj, tur&lt;br&gt;&lt;b&gt;Atomik yazma&lt;/b&gt; — geçici dosya + File.Move(overwrite)&lt;br&gt;Bozuk son satır yok sayılır&lt;br&gt;Git versiyonlar config/; runs/ gitignore" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="495" width="360" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="t-ops" value="&lt;b&gt;Araçlar ve süreç&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="460" width="380" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="t-ops-l" value="&lt;b&gt;PowerShell 5.1&lt;/b&gt; scripts/verify.ps1 (yalnız ASCII) — build, testler, Python sınır denetimi&lt;br&gt;&lt;b&gt;Windows 11&lt;/b&gt; — CLI oturumları Windows kullanıcısına bağlı; her kullanıcı ayrı giriş yapar&lt;br&gt;&lt;b&gt;Claude Code CLI&lt;/b&gt; (claude.exe) — Anthropic kimliği ve /usage ucu&lt;br&gt;&lt;b&gt;Git&lt;/b&gt; — config/ tek doğru kaynak&lt;br&gt;Sohbet Türkçe, kod İngilizce; kararlar belgeyle (docs/DOMAIN.md)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="495" width="360" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="t-dev" value="&lt;b&gt;Referans mimariden kasıtlı sapmalar&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="460" width="380" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="t-dev-l" value="✗ Veritabanı (EF, Npgsql, migration)&lt;br&gt;✗ Çok kiracılılık (tenant_id, filtre, guard)&lt;br&gt;✗ Gateway · ✗ Cache (FusionCache/Redis)&lt;br&gt;✗ Elastic / APM (Serilog dosyaya)&lt;br&gt;✗ Common projesi (Application'a sığıyor)&lt;br&gt;✗ Asp.Versioning (/api/v1 sabiti)&lt;br&gt;✗ Task.Api ayrı host → süreç içi JobWorker (202)&lt;br&gt;JWT tek şema, tek sınıf; hostlar yalnız loopback" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="495" width="360" height="190" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================ -->
  <!-- SAYFA 3 — .NET ONION KATMANLARI -->
  <!-- ============================================================ -->
  <diagram id="p3-onion" name="3 · .NET katmanları (Onion)">
