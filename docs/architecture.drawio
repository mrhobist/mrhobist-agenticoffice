        <mxCell id="o-inf" value="&lt;b&gt;MrHobist.AITeam.Infrastructure&lt;/b&gt; — adaptörler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
