  <!-- ============================================================ -->
  <!-- SAYFA 4 — EKİP VE İŞ AKIŞLARI -->
  <!-- ============================================================ -->
  <diagram id="p4-team" name="4 · Ekip ve iş akışları">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="k-title" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;Ekip tanımı ve iş akışları&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Takım = iş akışı. Ajanlar tek havuzdur (config/agents/*.md); proje bir akış seçer, akış her adımda bir ajanı çağırır. Ekip açıktır: UI'daki Ekip panelinden ajan/akış eklenir. &lt;b&gt;2026-09-23'ten beri canlı ekip tek ajandır&lt;/b&gt;; eski altı rollü ekip (analist · tasarımcı · developer · testçi · manager · organizatör) testlerin sabit fikstürüdür." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="k-pool" value="&lt;b&gt;Ajan havuzu — config/agents/*.md&lt;/b&gt; (frontmatter + gövde = sistem promptu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="700" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="k-a1" value="&lt;b&gt;Tek Kişilik Dev Kadro&lt;/b&gt; (tek-kisilik-dev-kadro)&lt;br&gt;&quot;Claude Code gibi çalışır: analist + developer + tester tek kişide. Asgari plan, tek görev, yaz-test et-doğrula-bitir.&quot;&lt;br&gt;&lt;br&gt;office_roles: pm, dev, qa&lt;br&gt;provider: anthropic · model: &lt;b&gt;claude-opus-5-5&lt;/b&gt; · effort: high&lt;br&gt;includes: backend-developer, frontend-developer-nuxt&lt;br&gt;mcp: [playwright] — gerçek tarayıcıda test&lt;br&gt;explore_model: claude-haiku-4-5 — keşif alt ajanı&lt;br&gt;max_instances: &lt;b&gt;5&lt;/b&gt; — iş geldikçe çoğalan kopyalar&lt;br&gt;&lt;br&gt;Gövde: önce hedef projeyi tanı (CLAUDE.md), mevcut desene uy; okuma disiplini (önce ara sonra dar oku); analiz asgari; test geliştirmenin son parçası; ekran değiştiyse tarayıcıda dene" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="160" width="420" height="235" as="geometry"/>
        </mxCell>
        <mxCell id="k-copies" value="&lt;b&gt;Kopyalar (2026-09-26)&lt;/b&gt;&lt;br&gt;Aynı md, max_instances kadar paralel iş: kilit, dağıtıcı ve &quot;meşgul&quot; kopya başına; kayıtta Agent + Worker; sahnede kapıdan giren/çıkan klon; kopya n'e port aralığı 5200+20(n−1). Aynı projenin iki çalışması aynı anda yazmaz. Aşama 2 (açık): kopya kopyayı alt ajan olarak çağırır." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="160" width="235" height="235" as="geometry"/>
        </mxCell>

        <mxCell id="k-kn" value="&lt;b&gt;config/knowledge/*.md&lt;/b&gt; — alt md'ler; composedPrompt = gövde + includes (plan görev başına yalnız gerekeni seçebilir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="770" y="120" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="k-kn1" value="backend-developer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="785" y="170" width="240" height="30" as="geometry"/></mxCell>
        <mxCell id="k-kn2" value="frontend-developer-nuxt (Playwright ile nasıl denenir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="785" y="208" width="240" height="30" as="geometry"/></mxCell>

        <mxCell id="k-mcp" value="&lt;b&gt;MCP yetkisi&lt;/b&gt; — tanım data/aiteam.db (mcp_server), yetki md'de (mcp: [...])&lt;br&gt;playwright: görünür Edge, --isolated, 14 araç açık (ekran görüntüsü/evaluate kapalı). Yalnız araçlı turda, mcp__playwright__* adıyla; strict_mcp_config. Her araç şeması iç tur başına ~4K token. Yalnız anthropic ajanlarında." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=11;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="770" y="270" width="270" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="k-fixture" value="&lt;b&gt;Test fikstürü (eski ekip)&lt;/b&gt;&lt;br&gt;tests/…ServiceTests/Fixtures/config/: analyst · designer · developer · tester · manager · organizer + 5 akış (default, tasarimli, tek kişi, ikili, tam kadro). Çok rollü mekanizmalar (organizatör devir notu, red → üretici adıma dönüş, can_ask, geçmiş sıkıştırma) kodda durur, tek ajanlı akışta uyur." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=11;spacingTop=6;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1070" y="120" width="270" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="k-wf1" value="&lt;b&gt;İş akışı: default (&quot;Tek Kişilik Dev Kadro&quot;)&lt;/b&gt; — config/workflows/default.json · handoffRole: null · maxReviewRounds: 1 · &lt;b&gt;planApprover: auto&lt;/b&gt; (plan onayı beklemez) · &lt;b&gt;askRole: user&lt;/b&gt; (takılınca doğrudan kullanıcıya sorar) · silinemez" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1300" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="k-w1s0" value="&lt;b&gt;Brief&lt;/b&gt;&lt;br&gt;+ ekler (PDF, resim, docx)&lt;br&gt;+ &quot;# Mevcut kod&quot; (içeri alınan / devam projesi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="500" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="k-w1s1" value="&lt;b&gt;Analiz&lt;/b&gt;&lt;br&gt;kind: analyze · role: tek-kisilik-dev-kadro · pm&lt;br&gt;salt okuma + keşif alt ajanı + MCP&lt;br&gt;→ Spec: asgari plan, tek görev, kod haritası (codeMap ≤3000 kr), ruleRefs, knowledge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="500" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="k-w1s2" value="&lt;b&gt;Geliştirme + Test&lt;/b&gt;&lt;br&gt;kind: implement · role: tek-kisilik-dev-kadro · dev&lt;br&gt;tam araç, cwd = hedef dizin, readDirs = ekler, Playwright MCP&lt;br&gt;yaz → testi yaz ve koş → kabul ölçütlerini doğrula → run.cmd&lt;br&gt;→ summary, filesChanged, commandsRun, blocked, question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="500" width="330" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="k-w1done" value="&lt;b&gt;done&lt;/b&gt;&lt;br&gt;ayrı testçi / manager yok" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="505" width="120" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="k-w1e0" value="POST /runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="k-w1s0" target="k-w1s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k-w1e1" value="planApprover auto → hemen dağıtım" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="k-w1s1" target="k-w1s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k-w1e2" value="rapor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="k-w1s2" target="k-w1done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k-w1ask" value="blocked=true → askRole user: soru kullanıcıya (retry · skip · cancel)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;strokeColor=#d6b656;fontColor=#8a6d00;exitX=0.4;exitY=1;entryX=0.6;entryY=1;" edge="1" parent="1" source="k-w1s2" target="k-w1s2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="832" y="615"/><mxPoint x="898" y="615"/></Array></mxGeometry></mxCell>

        <mxCell id="k-kinds" value="&lt;b&gt;Adım türleri (StageKind) ve araç erişimi — ToolAccess.ForKind, .NET belirler&lt;/b&gt;&lt;br&gt;&lt;b&gt;analyze&lt;/b&gt; — salt okuma (Read/Glob/Grep) → SpecSchema; çalışma başına bir kez; plan onayı akışın planApprover'ına göre (user · auto · ajan)&lt;br&gt;&lt;b&gt;design&lt;/b&gt; — salt okuma → guidance + decisions; kod yazmaz (üretici adım)&lt;br&gt;&lt;b&gt;implement&lt;/b&gt; — tam araç (Write/Edit/Bash, cwd içinde) → summary, filesChanged, commandsRun, blocked, question (üretici adım)&lt;br&gt;&lt;b&gt;review&lt;/b&gt; — kodu okur, testi koşar, uygulama kodunu değiştirmez → verdict, findings, feedback; red → önceki üretici adım (Workflow.ProducerBefore)&lt;br&gt;&lt;b&gt;handoff&lt;/b&gt; — araç yok → devir notu (handoffRole; null = yok)&lt;br&gt;&lt;b&gt;ask&lt;/b&gt; — askRole: null = ajanın can_ask'i · user · ajan anahtarı; ajan cevaplarsa yalnız okuma, {answer, escalate, reason}&lt;br&gt;Araçlı her turda ek: MCP sunucuları (md yetkisi), keşif alt ajanı (explore_model), readDirs (ekler), progressUrl (canlı araç + kullanım)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="780" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="k-rules" value="&lt;b&gt;Dağıtım kuralları (Dispatcher)&lt;/b&gt;&lt;br&gt;• Hazır görev: dependsOn'daki görevler done (topolojik sıra)&lt;br&gt;• Kopya (worker) başına tek iş; kopyalar ve farklı ajanlar paralel; iş havuzu 6&lt;br&gt;• Çalışma içinde sıralı, çalışmalar arası paralel; aynı projenin iki çalışması aynı anda yazmaz&lt;br&gt;• Red → en yakın önceki üretici adım (design/implement), feedback notuyla&lt;br&gt;• maxReviewRounds kapı başına; aşılınca askRole'e soru (retry / skip / cancel)&lt;br&gt;• Sağlayıcı/model ajan frontmatter'ından; boşsa anthropic · claude-opus-5-5 · high&lt;br&gt;• Hassasiyet Anthropic olan çalışma OpenAI'ye çıkamaz (PolicyRejected)&lt;br&gt;• Her LLM çağrısından önce LimitGuard (kota eşiği %99) ve bütçe (iş + proje; önce dolan durdurur)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="660" width="490" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="k-i1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="k-a1" target="k-kn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="140"/><mxPoint x="760" y="140"/><mxPoint x="760" y="185"/></Array></mxGeometry></mxCell>
        <mxCell id="k-i2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="k-a1" target="k-mcp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="482" y="340"/><mxPoint x="755" y="340"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================ -->
  <!-- SAYFA 5 — ÇALIŞMA YAŞAM DÖNGÜSÜ -->
  <!-- ============================================================ -->
  <diagram id="p5-lifecycle" name="5 · Çalışma yaşam döngüsü">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="l-title" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;Çalışma (Run) yaşam döngüsü — RunStatus durum makinesi&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Enum adıyla taşınır, üye sona eklenir: Running · Completed · Failed · Interrupted · BudgetExceeded · PolicyRejected · AwaitingApproval · Paused · Cancelled · AwaitingInput. Her geçiş run satırına yazılır, sahneye olay olur." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="l-start" value="POST /runs&lt;br&gt;{project, brief, workflow?, sensitivity?, maxCostUsd?, attachments[]?}&lt;br&gt;202 → akış run.workflow_snapshot'a dondurulur; ekler data/attachments/{runId}'ye taşınır" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="l-pol" value="&lt;b&gt;PolicyRejected&lt;/b&gt; hassasiyete aykırı ajan&lt;br&gt;&lt;b&gt;400 project.budget_exceeded&lt;/b&gt; proje tavanı doluysa hiç başlamaz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="230" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l-run1" value="&lt;b&gt;Running&lt;/b&gt; (step: analiz)&lt;br&gt;Spec üretilir&lt;br&gt;sahne: agent.state working, run.stage Analiz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="200" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="l-aa" value="&lt;b&gt;AwaitingApproval&lt;/b&gt;&lt;br&gt;planApprover: &lt;b&gt;user&lt;/b&gt; → kullanıcı onayı (gelen kutusu)&lt;br&gt;&lt;b&gt;auto&lt;/b&gt; (bugünkü akış) → bu durum atlanır&lt;br&gt;&lt;b&gt;ajan&lt;/b&gt; → ajan inceler, maxReviewRounds sonra kullanıcıya" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="190" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="l-run2" value="&lt;b&gt;Running&lt;/b&gt; (dağıtım)&lt;br&gt;Dispatcher: planla → adım koş → yeniden planla&lt;br&gt;board.set / board.move / agent.state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="360" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="l-done" value="&lt;b&gt;Completed&lt;/b&gt;&lt;br&gt;tüm görevler son adımdan geçti" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="360" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="l-ai" value="&lt;b&gt;AwaitingInput&lt;/b&gt;&lt;br&gt;soru (askRole'e göre): blocked, review tavanı, aynı adımda tekrar hata&lt;br&gt;seçenekler: retry · skip · cancel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="500" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="l-paused" value="&lt;b&gt;Paused&lt;/b&gt;&lt;br&gt;limit eşiği (%99) doldu ya da çağrı sırasında doldu (runtime.provider_limit) · resumeAt&lt;br&gt;RunResumer dakikada bir bakar, kendisi sürdürür (faz cause: limit, tur sayılmaz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="500" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="l-fail" value="&lt;b&gt;Failed&lt;/b&gt; sağlayıcı/adım hatası&lt;br&gt;&lt;b&gt;Interrupted&lt;/b&gt; süreç yeniden başladı&lt;br&gt;&lt;b&gt;BudgetExceeded&lt;/b&gt; iş ya da proje tavanı (token / ≈$) tur sonunda doldu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="500" width="200" height="100" as="geometry"/>
        </mxCell>
