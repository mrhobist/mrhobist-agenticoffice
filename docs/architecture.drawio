        <mxCell id="o-api-8" value="&lt;b&gt;Jobs/&lt;/b&gt;JobChannel (çalışma başına kilit; aynı projenin iki çalışması aynı anda yazmaz) · JobWorker havuzu (6) · RunScheduler · RunResumer (açılışta Running→Interrupted; dakikada bir limit süresi dolanı sürdürür)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="391" width="490" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="o-api-9" value="&lt;b&gt;Runtime/&lt;/b&gt;RuntimeSupervisor — Python runtime'ı başlatır/durdurur (AITeam:AutoStartRuntime) · &lt;b&gt;Errors/&lt;/b&gt;ProblemMapping — Problem Details + errorCode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="455" width="490" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="o-api-10" value="Uçlar &lt;b&gt;hızlı doğrulama&lt;/b&gt; yapar, uzun işi kanala bırakır, 202 döner. Okuma IRunReader." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="507" width="490" height="40" as="geometry"/>
        </mxCell>

        <!-- Infrastructure -->
        <mxCell id="o-inf" value="&lt;b&gt;MrHobist.AITeam.Infrastructure&lt;/b&gt; — adaptörler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="520" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="o-inf-1" value="&lt;b&gt;Persistence/&lt;/b&gt; AiTeamContext (EF Core, sütun adları elle) · Rows · SchemaMigrator (scripts/sql/changes, checksum defteri, ProbeDatabaseAsync drift) · SqliteRunStore (IRunStore + IRunReader) · SqliteProjectStore · SqliteSettingsStore · SqliteMcpStore · PersistenceJson · UtcTextConverter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="615" y="135" width="490" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o-inf-2" value="&lt;b&gt;Storage/&lt;/b&gt; AtomicFile · Frontmatter · MarkdownAgentStore (agents, knowledge) · JsonWorkflowStore · JsonSceneLayoutStore · JsonModelCatalog (models.json) · JsonMcpCatalog (mcp-catalog.json) · StoragePaths / WorkspaceLocator · WorkspaceInspector (git ls-files, dil payı, README/package.json) · GitWorkspaceSnapshot (gölge depo, görev farkı) · FileAttachmentStore (data/attachments, docx→txt) · WindowsProjectLauncher (run.cmd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="615" y="223" width="490" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="o-inf-3" value="&lt;b&gt;Runtime/&lt;/b&gt; PythonAgentRuntimeClient (IAgentRuntimeService; HTTP 5090; 503/502 eşlemesi; bağlantı kesilirse tur durur) · PythonRuntimeProcess (uvicorn alt süreci) · McpOAuthHttpClient (RFC 9728/8414/7591, PKCE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="615" y="341" width="490" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="o-inf-4" value="&lt;b&gt;Compaction/&lt;/b&gt; MafHistoryCompactor — Microsoft.Agents.AI statik CompactionProvider: Truncation → SlidingWindow; model yok, özet yok" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="615" y="409" width="490" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="o-inf-5" value="&lt;b&gt;DependencyInjection.cs&lt;/b&gt; — AddInfrastructure(): DbContext, store'lar, runtime istemcisi, kataloglar, snapshot, ek deposu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="615" y="461" width="490" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="o-inf-6" value="Python kapalıyken derleme ve ServiceTests bozulmaz: testler &lt;b&gt;sahte IAgentRuntimeService&lt;/b&gt; ile, depoları DI'dan alarak koşar." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="615" y="509" width="490" height="40" as="geometry"/>
        </mxCell>

        <!-- Application -->
        <mxCell id="o-app" value="&lt;b&gt;MrHobist.AITeam.Application&lt;/b&gt; — iş kuralları ve orkestrasyon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1080" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="o-app-1" value="&lt;b&gt;Abstractions/&lt;/b&gt; (portlar)&lt;br&gt;IAgentRuntimeService — LLM turu&lt;br&gt;IStores — IAgentStore, IWorkflowStore, IProjectStore, IRunStore, IRunReader, ISettingsStore&lt;br&gt;IMcpStore · IMcpCatalog · IModelCatalog&lt;br&gt;IAttachmentStore · IWorkspaceSnapshot&lt;br&gt;IHistoryCompactor · IRunScheduler&lt;br&gt;ISceneEventPublisher · ISceneLayout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="55" y="645" width="330" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="o-app-2" value="&lt;b&gt;Runs/&lt;/b&gt;&lt;br&gt;&lt;b&gt;RunService&lt;/b&gt; — yaşam döngüsü (start, approve, revise, answer, retry, cancel, resume), ekler, bütçe, BoardTarget, AgentTaskHistory (compaction)&lt;br&gt;&lt;b&gt;Dispatcher&lt;/b&gt; — DispatchAsync: planla → adım koş → yeniden planla; NextStage; kopya (worker) seçimi, max_instances&lt;br&gt;&lt;b&gt;AgentCaller&lt;/b&gt; — istemi kurar, ToolAccess.ForKind, MCP + alt ajan + readDirs, progressUrl belirteci, turu kaydeder&lt;br&gt;&lt;b&gt;Explorer&lt;/b&gt; — explore_model doluysa salt okunur keşif alt ajanı (Haiku), yalnız araçlı turda, yalnız anthropic&lt;br&gt;&lt;b&gt;LimitGuard&lt;/b&gt; — kota eşiği; dolunca Paused + resumeAt · &lt;b&gt;ProgressRegistry&lt;/b&gt; — araç + kullanım geri çağrısı&lt;br&gt;&lt;b&gt;Prompts · SpecSchema · StepSchemas&lt;/b&gt; — adım şemaları, kod haritası, &quot;# Mevcut kod&quot;, &quot;# Ekler&quot;&lt;br&gt;&lt;b&gt;CodeDigest&lt;/b&gt; (görev başında yazılan kodun imzaları) · &lt;b&gt;TokenCalibration&lt;/b&gt; (karakter/token) · &lt;b&gt;RunReader · UsageReader · SpendReader&lt;/b&gt; (kim ne harcadı)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="645" width="705" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="o-app-3" value="&lt;b&gt;Agents/&lt;/b&gt;AgentService — CRUD, import, composedPrompt (gövde + includes), sahne/sprite, mcp ve explore_model doğrulama, in_use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="815" width="330" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="o-app-4" value="&lt;b&gt;Workflows/&lt;/b&gt;WorkflowService (upsert, default korumalı, değişmezler) · WorkflowMapping · Workflow.ProducerBefore (geri dönüş kuralının tek kaynağı) · planApprover · askRole" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="400" y="815" width="340" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="o-app-5" value="&lt;b&gt;Projects/&lt;/b&gt;ProjectService — kart, targetDir, içeri alma (inspect önerisi), bütçe, sıralama, silme · &lt;b&gt;Mcp/&lt;/b&gt;McpService, McpOAuthService, McpDefaults (ofis standardı), McpUsageReader" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="755" y="815" width="350" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="o-app-6" value="&lt;b&gt;Common/&lt;/b&gt;NotFoundException · CompactionBudget.TaskHistory (4 mesaj / 12k token) · AttachmentRules (tür, 20 MB, 10 ek)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="881" width="1050" height="40" as="geometry"/>
        </mxCell>

        <!-- Domain -->
        <mxCell id="o-dom" value="&lt;b&gt;MrHobist.AITeam.Domain&lt;/b&gt; — çekirdek (bağımlılığı yok, EF yok)&lt;br&gt;Agents (AgentDefinition: frontmatter alanları, mcp, explore_model, max_instances) · Workflows (Workflow, Stage, StageKind: analyze/design/implement/review/handoff; planApprover, askRole) · Runs (Run, RunStatus, Phase, Turn, Message, TaskGraph, Question, Attachment) · Projects (Project, Codebase: linguist özü dil ölçüsü) · Mcp (McpServer, McpCatalog) · Settings · ErrorCodes · DomainException · Identifiers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontSize=13;spacingTop=6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="1080" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="o-tests" value="&lt;b&gt;tests/&lt;/b&gt;&lt;br&gt;UnitTests (Domain + Application saf mantık; Codebase, kopya seçimi…)&lt;br&gt;ServiceTests (Api uçları, sahte runtime, geçici SQLite; eski altı rollü ekip Fixtures/config altında sabit fikstür)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
