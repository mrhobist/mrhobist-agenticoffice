  <!-- ============================================================ -->
  <!-- SAYFA 6 — BİR TURUN YOLCULUĞU -->
  <!-- ============================================================ -->
  <diagram id="p6-turn" name="6 · Bir LLM turunun yolculuğu">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="q-title" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;Bir LLM turunun yolculuğu — &quot;Geliştirme + Test&quot; (implement) adımı&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Numaralı oklar sırayı verir. Düz ok = eşzamanlı HTTP; kesik ok = geri çağrı / yayın. .NET karar verir, Python yalnız çağırır, model dosyayı hedef dizinde kendisi yazar." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="q-ui" value="&lt;b&gt;UI&lt;/b&gt;&lt;br&gt;RunPanel · OfficeScene" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="q-ep" value="&lt;b&gt;RunEndpoints&lt;/b&gt;&lt;br&gt;doğrula (bütçe, ekler), 202" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="140" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="q-job" value="&lt;b&gt;JobChannel → JobWorker&lt;/b&gt;&lt;br&gt;çalışma başına kilit; aynı proje sıralı" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="q-disp" value="&lt;b&gt;Dispatcher&lt;/b&gt;&lt;br&gt;hazır görev + boş kopya → atama&lt;br&gt;LimitGuard + iş/proje bütçesi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="780" y="140" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="q-call" value="&lt;b&gt;AgentCaller&lt;/b&gt;&lt;br&gt;composedPrompt + görev + kod haritası + &quot;şimdiye kadar yazılan kod&quot; (CodeDigest, gölge git farkı) + ekler yolu + kopya port aralığı → messages&lt;br&gt;ToolAccess.ForKind(implement) = tam · cwd = hedef dizin · readDirs = ek dizini&lt;br&gt;mcpServers (md yetkisi + izin listesi, OAuth belirteci yenilenir) · agents (Explorer: keşif alt ajanı) · cacheTtl&lt;br&gt;ProgressRegistry: tek kullanımlık progressUrl · StepSchemas.Implement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="250" width="460" height="120" as="geometry"/></mxCell>
        <mxCell id="q-cli" value="&lt;b&gt;PythonAgentRuntimeClient&lt;/b&gt;&lt;br&gt;IAgentRuntimeService → HTTP; iptal bağlantıyı keser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="410" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="q-rt" value="&lt;b&gt;runtime POST /v1/turn&lt;/b&gt;&lt;br&gt;provider'a göre adaptör (anthropic.py) · kimlik: env &amp;gt; credentials.json &amp;gt; CLI oturumu · cacheTtl → CLI ortam değişkeni" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="520" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="q-sdk" value="&lt;b&gt;Claude Agent SDK → claude.exe&lt;/b&gt;&lt;br&gt;ajan döngüsü: düşün → araç çağır → sonucu gör → tekrar (120 iç tura kadar)&lt;br&gt;can_use_tool (_guard): Write/Edit yalnız cwd; Bash'te mutlak yol/~/.. ret; MCP izin listesi; Agent aracı yalnız verilen alt ajanla&lt;br&gt;strict_mcp_config: yalnız verilen MCP'ler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="640" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="q-dir" value="&lt;b&gt;hedef dizin&lt;/b&gt;&lt;br&gt;dosyalar yazılır, build/test koşar, run.cmd" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="640" width="160" height="100" as="geometry"/></mxCell>
        <mxCell id="q-mcp" value="&lt;b&gt;Playwright MCP&lt;/b&gt; (Edge)&lt;br&gt;navigate, snapshot, click, fill…&lt;br&gt;&lt;b&gt;keşif alt ajanı&lt;/b&gt; (Haiku, Read/Glob/Grep, ≤25 iç tur)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1200" y="770" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="q-prog" value="&lt;b&gt;POST /progress/{token}&lt;/b&gt;&lt;br&gt;{tool, target} ya da {kind: usage, …} · 2 s zaman aşımı · hata yutulur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="650" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="q-bus" value="&lt;b&gt;SceneEventBus (SSE)&lt;/b&gt;&lt;br&gt;agent.tool · agent.state · board.move · run.stage · agent.enter/leave (kopya)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="410" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="q-db" value="&lt;b&gt;data/aiteam.db&lt;/b&gt;&lt;br&gt;run_phase Started/Done · run_turn (prompt, çıktı, token + cache, cost, hedef, toolUses, mcpServers, modelUsage, peakContextTokens, context) · run (token toplamı)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="250" width="220" height="120" as="geometry"/></mxCell>

        <mxCell id="qe1" value="1. POST /runs (brief + ekler)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="q-ui" target="q-ep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe2" value="2. kuyruğa iş, 202" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="q-ep" target="q-job"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe3" value="3. DispatchAsync (analiz bitti, planApprover auto)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="q-job" target="q-disp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe4" value="4. adımı koş" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="q-disp" target="q-call"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe4b" value="4a. Started fazı" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="q-call" target="q-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe4c" value="4b. board.move · agent.state working (kopya girer)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="q-disp" target="q-bus"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="170"/><mxPoint x="760" y="390"/><mxPoint x="400" y="390"/></Array></mxGeometry></mxCell>
        <mxCell id="qe5" value="5. TurnRequest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="q-call" target="q-cli"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe6" value="6. HTTP 127.0.0.1:5090" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="q-cli" target="q-rt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe7" value="7. query(prompt, tools, cwd, add_dirs, mcp, agents, schema)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="q-rt" target="q-sdk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe8" value="8. Read/Write/Edit/Bash" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="q-sdk" target="q-dir"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qe8b" value="8a. mcp__playwright__* · Agent(kesif)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="q-sdk" target="q-mcp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="815"/></Array></mxGeometry></mxCell>
        <mxCell id="qe9" value="9. her araç çağrısı + her mesajın kullanımı" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="q-sdk" target="q-prog"><mxGeometry relative="1" as="geometry"/></mxCell>
