        <mxCell id="o-app" value="&lt;b&gt;MrHobist.AITeam.Application&lt;/b&gt; — iş kuralları ve orkestrasyon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1080" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="o-app-1" value="&lt;b&gt;Abstractions/&lt;/b&gt; (portlar)&lt;br&gt;IAgentRuntimeService — LLM turu&lt;br&gt;IRunScheduler — limit sonrası uyandır&lt;br&gt;ISceneEventPublisher — sahne olayı&lt;br&gt;ISceneLayout — scene.json&lt;br&gt;IStores — IAgentStore, IWorkflowStore, IProjectStore, IRunStore, IRunReader, ISettingsStore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="55" y="595" width="330" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="o-app-2" value="&lt;b&gt;Runs/&lt;/b&gt;&lt;br&gt;&lt;b&gt;RunService&lt;/b&gt; — yaşam döngüsü (start, approve, revise, answer, retry, cancel), BoardTarget&lt;br&gt;&lt;b&gt;Dispatcher&lt;/b&gt; — DispatchAsync: planla → adım koş → yeniden planla; NextStage (geri dönüş)&lt;br&gt;&lt;b&gt;AgentCaller&lt;/b&gt; — prompt kurar, ToolAccess.ForKind, progressUrl belirteci, turu kaydeder&lt;br&gt;&lt;b&gt;LimitGuard&lt;/b&gt; — kota eşiği; dolunca Paused + resumeAt&lt;br&gt;&lt;b&gt;ProgressRegistry&lt;/b&gt; — tek kullanımlık belirteç → agent.tool&lt;br&gt;&lt;b&gt;Prompts · SpecSchema · StepSchemas&lt;/b&gt; — adım şemaları (analyze/design/implement/review/ask)&lt;br&gt;&lt;b&gt;RunReader · UsageReader&lt;/b&gt; — özet, tur, maliyet toplamı · &lt;b&gt;RunModels&lt;/b&gt; DTO'lar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="400" y="595" width="705" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="o-app-3" value="&lt;b&gt;Agents/&lt;/b&gt;AgentService — CRUD, import, composedPrompt (gövde + includes), sahneye yerleştirme, in_use denetimi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1">
