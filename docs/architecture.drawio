        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t-title" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;Teknoloji yığını&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Üç süreç, SQLite, sıfır gateway. Kasıtlı sapmalar sağ altta." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="t-ui" value="&lt;b&gt;Frontend — ui/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="380" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="t-ui-l" value="&lt;b&gt;Nuxt 4.2&lt;/b&gt; (SPA kabuğu, tek sayfa app.vue)&lt;br&gt;&lt;b&gt;Vue 3.5&lt;/b&gt; Composition API, &amp;lt;script setup&amp;gt;&lt;br&gt;&lt;b&gt;TypeScript 5.9&lt;/b&gt; + vue-tsc typecheck&lt;br&gt;&lt;b&gt;Canvas 2D&lt;/b&gt; — sprite tabanlı piksel ofis, kendi oyun döngüsü (world.ts); balkon, kedi kapları prosedürel&lt;br&gt;&lt;b&gt;openapi-typescript 7&lt;/b&gt; — /openapi/v1.json → shared/types/api.ts (elle yazılmaz)&lt;br&gt;&lt;b&gt;EventSource&lt;/b&gt; (SSE) + fetch yoklama&lt;br&gt;&lt;b&gt;Ico.vue&lt;/b&gt; tek renkli SVG ikon seti · &lt;b&gt;LangBar&lt;/b&gt; linguist renkleri&lt;br&gt;Sprite hattı: Python Pillow script → PNG atlas + atlas.json" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="135" width="360" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="t-net" value="&lt;b&gt;Backend — src/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="380" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="t-net-l" value="&lt;b&gt;.NET 10&lt;/b&gt; · C# · Minimal API · Onion (Domain / Application / Infrastructure / Api)&lt;br&gt;&lt;b&gt;EF Core 10 + Microsoft.Data.Sqlite&lt;/b&gt; — yalnız eşler; şema ileri yönlü SQL betikleri (database-first), SchemaMigrator + schema_change_log&lt;br&gt;&lt;b&gt;Microsoft.Agents.AI 1.22&lt;/b&gt; — yalnız Compaction (taşınan geçmişi kırpma), LLM çağrısı için değil&lt;br&gt;&lt;b&gt;OpenApi + Scalar&lt;/b&gt; · &lt;b&gt;JwtBearer&lt;/b&gt; (tek şema, rol claim'i)&lt;br&gt;&lt;b&gt;Http.Resilience&lt;/b&gt; — runtime istemcisi · &lt;b&gt;Serilog&lt;/b&gt; → dosya&lt;br&gt;&lt;b&gt;System.Threading.Channels&lt;/b&gt; — JobChannel / JobWorker&lt;br&gt;&lt;b&gt;SSE&lt;/b&gt; SceneEventBus · &lt;b&gt;Problem Details&lt;/b&gt; + errorCode&lt;br&gt;&lt;b&gt;xunit 2.9&lt;/b&gt; — 53 birim + 181 servis testi (2026-09-26)&lt;br&gt;Central Package Management, slnx, -warnaserror" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="135" width="360" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="t-py" value="&lt;b&gt;LLM katmanı — runtime/&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="100" width="380" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="t-py-l" value="&lt;b&gt;Python 3.12&lt;/b&gt; (runtime/.venv, cihaza bağlı; onarım verify.ps1 -SetupRuntime)&lt;br&gt;&lt;b&gt;FastAPI ≥0.120&lt;/b&gt; + &lt;b&gt;uvicorn&lt;/b&gt;&lt;br&gt;&lt;b&gt;pydantic 2&lt;/b&gt; — sözleşme modelleri (camelCase alias)&lt;br&gt;&lt;b&gt;httpx&lt;/b&gt; — progressUrl, OpenAI Responses API, limit ucu&lt;br&gt;&lt;b&gt;claude-agent-sdk ≥0.2&lt;/b&gt; — claude.exe oturumu üstünden ajan döngüsü, araçlar, MCP, alt ajan, can_use_tool&lt;br&gt;&lt;b&gt;mcp ≥2.2&lt;/b&gt; — bağlantı denemesi (mcp_probe)&lt;br&gt;&lt;b&gt;Codex CLI&lt;/b&gt; (npm @openai/codex) — codex exec --json&lt;br&gt;&lt;b&gt;pytest&lt;/b&gt; + pytest-asyncio + respx&lt;br&gt;Kimlik: CLI oturumu (OAuth) &lt;i&gt;veya&lt;/i&gt; API anahtarı (credentials.json)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="135" width="360" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="t-store" value="&lt;b&gt;Depolama — iki yer, iki sorumluluk&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="380" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="t-store-l" value="&lt;b&gt;config/ (git)&lt;/b&gt; — Markdown + YAML frontmatter (ajan, bilgi), JSON (akış, sahne, model kataloğu, MCP kataloğu). Atomik yazma: geçici dosya + File.Move&lt;br&gt;&lt;b&gt;data/aiteam.db (gitignore)&lt;/b&gt; — SQLite WAL: proje, çalışma, tur, mesaj, faz, ayar, MCP sunucusu. Sorgulanan alan sütun + yük JSON sütun (opencode örüntüsü). Append-only satır; AUTOINCREMENT id sıra; FK cascade&lt;br&gt;&lt;b&gt;data/attachments/&lt;/b&gt; — iş ekleri&lt;br&gt;&lt;b&gt;MCP sırları&lt;/b&gt; veritabanında (git'e girmez), yetki md'de (git'te)&lt;br&gt;Bozuk JSON gövdeli satır yok sayılır; uygulanmış betik değişirse kalkış durur" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="495" width="360" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="t-ops" value="&lt;b&gt;Araçlar ve süreç&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="460" width="380" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="t-ops-l" value="&lt;b&gt;PowerShell 5.1&lt;/b&gt; scripts/verify.ps1 (yalnız ASCII) — build, testler, Python sınırı, Domain'de EF yok&lt;br&gt;&lt;b&gt;Windows 11&lt;/b&gt;, birden çok kullanıcı — CLI oturumları ve .venv kullanıcıya bağlı&lt;br&gt;&lt;b&gt;Claude Code CLI&lt;/b&gt; (claude.exe) — Anthropic kimliği, /usage ucu, yerel oturum kayıtları (kim ne harcadı)&lt;br&gt;&lt;b&gt;Playwright MCP 0.0.82&lt;/b&gt; + makinedeki Edge — gerçek tarayıcıda test&lt;br&gt;&lt;b&gt;Git&lt;/b&gt; — config/ tek doğru kaynak; hedef dizinde gölge anlık görüntü&lt;br&gt;&lt;b&gt;scripts/context-report.py&lt;/b&gt; — bağlam/token ölçümü&lt;br&gt;Sohbet Türkçe, kod İngilizce; kararlar belgeyle (docs/DOMAIN.md, PHASES.md)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="495" width="360" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="t-dev" value="&lt;b&gt;Referans mimariden kasıtlı sapmalar&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontSize=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="860" y="460" width="380" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="t-dev-l" value="&lt;b&gt;PostgreSQL yerine SQLite&lt;/b&gt; (2026-09-21; numaralı SQL, defter ve drift testi var; EF migration yok; DDL kalkışta)&lt;br&gt;✗ Çok kiracılılık (tenant_id, filtre, guard)&lt;br&gt;✗ Gateway · ✗ Cache (FusionCache/Redis)&lt;br&gt;✗ Elastic / APM (Serilog dosyaya)&lt;br&gt;✗ Common projesi (Application'a sığıyor)&lt;br&gt;✗ Asp.Versioning (/api/v1 sabiti)&lt;br&gt;✗ Task.Api ayrı host → süreç içi JobWorker (202)&lt;br&gt;JWT tek şema, tek sınıf; hostlar yalnız loopback&lt;br&gt;Runtime'ı Api başlatır (iki terminal açmamak için)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="495" width="360" height="210" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================ -->
  <!-- SAYFA 3 — .NET ONION KATMANLARI -->
  <!-- ============================================================ -->
  <diagram id="p3-onion" name="3 · .NET katmanları (Onion)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169">
      <root>
        <mxCell id="0"/>
