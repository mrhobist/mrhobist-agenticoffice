        </mxCell>
        <mxCell id="o-inf-1" value="&lt;b&gt;Storage/&lt;/b&gt;&lt;br&gt;AtomicFile — geçici dosya + Move(overwrite)&lt;br&gt;Frontmatter — md ayrıştırma&lt;br&gt;MarkdownAgentStore — config/agents, knowledge&lt;br&gt;JsonWorkflowStore · JsonProjectStore · JsonSceneLayoutStore · JsonSettingsStore&lt;br&gt;JsonlRunStore — runs/ (IRunStore + IRunReader; bozuk son satırı atar)&lt;br&gt;StoragePaths — depo kökü çözümü&lt;br&gt;WindowsProjectLauncher — run.cmd yeni konsolda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
