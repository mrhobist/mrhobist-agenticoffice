        <mxCell id="qe11" value="11. SSE → balon, &quot;Şu an&quot; şeridi; GET /runs/{id}/live" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="q-bus" target="q-ui"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="440"/></Array></mxGeometry></mxCell>
        <mxCell id="qe12" value="12. TurnResponse {text, structured, usage, costUsd, toolUses, modelUsage, peakContextTokens}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;strokeColor=#d6b656;" edge="1" parent="1" source="q-rt" target="q-call"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="555"/><mxPoint x="1160" y="310"/></Array></mxGeometry></mxCell>
        <mxCell id="qe13" value="13. tur + Done/Failed fazı + token/maliyet toplamı + anlık görüntü" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="q-call" target="q-db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="340"/><mxPoint x="760" y="355"/></Array></mxGeometry></mxCell>
        <mxCell id="qe14" value="14. yeniden planla (sonraki görev / soru / bitti)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="q-call" target="q-disp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="310"/><mxPoint x="1260" y="120"/><mxPoint x="880" y="120"/></Array></mxGeometry></mxCell>
        <mxCell id="qe15" value="UI 2 s'de bir GET /runs/{id}, 5 s'de bir /runs/overview" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="q-ui" target="q-db"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="200" as="sourcePoint"/><Array as="points"><mxPoint x="120" y="310"/></Array></mxGeometry></mxCell>

        <mxCell id="q-note" value="&lt;b&gt;Sonuç şeması (implement):&lt;/b&gt; summary, filesChanged[], commandsRun[], blocked, question. blocked=true → akışın askRole'üne (bugün user) soru: AwaitingInput, retry/skip/cancel.&lt;br&gt;&lt;b&gt;Kesilen tur da harcamadır:&lt;/b&gt; iptal, limit ya da hata halinde biriken kullanım cutShort=true ile yazılır, maliyet config/models.json fiyatından tahmin edilir. Alt ajanın payı kendi modelinin fiyatıyla (modelUsage).&lt;br&gt;&lt;b&gt;OpenAI/Codex yolunda&lt;/b&gt; adım 7–9 yerine codex exec --json (sandbox workspace-write); araç olayları tur sonunda; MCP/alt ajan yok. &lt;b&gt;API anahtarıyla OpenAI&lt;/b&gt;: araçlı adım 501 runtime.tools_unsupported." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1320" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================ -->
  <!-- SAYFA 7 — UI -->
  <!-- ============================================================ -->
  <diagram id="p7-ui" name="7 · UI nasıl çalışıyor">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="u-title" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;UI — Nuxt 4 + Canvas 2D piksel ofis&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Tek sayfa (app.vue). Yerleşimin kopyasını tutmaz: sahne yerleşimi, pano sütunları ve olaylar Api'den gelir. Api kapalıysa sahne yüklenmez ve bunu söyler; SSE kopunca &quot;sahte yönetmen&quot; aynı şekildeki olayları üretir ve rozet gösterir." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="u-shell" value="&lt;b&gt;app.vue — kabuk&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="760" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="u-top" value="&lt;b&gt;Üst bar&lt;/b&gt; — Ekip (E) · İşler · Kanban · MCP · Ayarlar · &lt;b&gt;LimitsBar&lt;/b&gt; (GET /limits: kalan kota yüzdesi, sağlayıcı başına; API anahtarında &quot;kalan hak alınamadı&quot;) · bildirim zili (inbox: onay, soru, hata, limit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="145" width="730" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="u-rail" value="&lt;b&gt;Proje rayı&lt;/b&gt; (sol) — ProjectCard'lar: running / awaitingApproval / paused / failed rozetleri; ince dil şeridi (LangBar compact, 60 s'de bir); sıralama reorder; tık → ProjectPanel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="199" width="200" height="346" as="geometry"/>
        </mxCell>
        <mxCell id="u-scene" value="&lt;b&gt;OfficeScene.vue&lt;/b&gt; — Canvas 2D&lt;br&gt;&lt;b&gt;scene/world.ts&lt;/b&gt; oyun döngüsü, HUD, ambient (kedi, kapı, ışık, ziyaretçi)&lt;br&gt;&lt;b&gt;entities.ts&lt;/b&gt; ajan sprite'ları ve &lt;b&gt;kopyalar&lt;/b&gt; (kapıdan giren/çıkan klon, &quot;Kadro 2/3&quot;), durum noktası, balonlar, yürüyüş&lt;br&gt;&lt;b&gt;board.ts&lt;/b&gt; pano: akış sütunları + görev notları, rozet&lt;br&gt;&lt;b&gt;nav.ts&lt;/b&gt; yol bulma · &lt;b&gt;atlas.ts&lt;/b&gt; sprite atlası · &lt;b&gt;sky.ts&lt;/b&gt; pencere manzarası&lt;br&gt;&lt;b&gt;balcony.ts&lt;/b&gt; cam sürgülü kapı + korkuluk · &lt;b&gt;bowls.ts&lt;/b&gt; kedinin mama/su kapları (prosedürel)&lt;br&gt;&lt;b&gt;feed.ts&lt;/b&gt; SSE bağlantısı + sahte yönetmen · &lt;b&gt;contract.ts&lt;/b&gt; olay tipleri (docs/SCENE.md)&lt;br&gt;Tuvale tık: ajan seç (AgentPanel; kopyaya tık ana ajanı açar) · ışık aç/kapat (komut olarak Api'ye)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="265" y="199" width="520" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="u-compass" value="&lt;b&gt;Pusula&lt;/b&gt; — ekip halkası: ajanlar durum rengiyle (kopyalar iş aldıkça belirir); Yönet → TeamPanel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="265" y="419" width="250" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="u-login" value="&lt;b&gt;LoginPanel&lt;/b&gt; — POST /auth/login → JWT (useAuth composable); giriş yoksa kabuk açılmaz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="525" y="419" width="260" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="u-boot" value="&lt;b&gt;İlk yükleme:&lt;/b&gt; GET /providers (giriş var mı? yoksa uyarı) · /agents · /projects · /scene · /workflows/{key} · /runs/overview; sonra SSE'ye bağlan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="265" y="485" width="520" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="u-panels" value="&lt;b&gt;Paneller (components/) — sahnenin üstünde açılır, aynı kapat düğmesi&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="830" y="110" width="520" height="450" as="geometry"/>
        </mxCell>
        <mxCell id="u-p1" value="&lt;b&gt;RunPanel&lt;/b&gt; — çalışma: durum, adım, plan (approve/revise), soru düğmeleri (answer), retry/cancel, günlük (turns: tam prompt+çıktı, araçlar, MCP), canlı bağlam (/live), ekler (indir), &quot;Şu an&quot; şeridi; 2 s yoklama" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845" y="145" width="490" height="56" as="geometry"/></mxCell>
        <mxCell id="u-p2" value="&lt;b&gt;ProjectPanel&lt;/b&gt; — proje kartı, hedef dizin (DirPicker), &lt;b&gt;mevcut projeyi içeri al&lt;/b&gt; (inspect önerisi), akış seçimi, bütçe (≈$ / token), İşler sekmesi (dil şeridi + lejant, git dalı), yeni brief + ekler (sürükle-bırak, yapıştır), Başlat (run.cmd), silme" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845" y="209" width="490" height="60" as="geometry"/></mxCell>
        <mxCell id="u-p3" value="&lt;b&gt;KanbanPanel&lt;/b&gt; — proje × akış sütunu; api/board.ts görev hedefini türetir (ProducerBefore kuralının TS kopyası)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845" y="277" width="490" height="40" as="geometry"/></mxCell>
        <mxCell id="u-p4" value="&lt;b&gt;JobsPanel&lt;/b&gt; — RunsOverview: kaç iş, hangi durumda, gelen kutusu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845" y="325" width="490" height="34" as="geometry"/></mxCell>
        <mxCell id="u-p5" value="&lt;b&gt;TeamPanel&lt;/b&gt; — Ajanlar (havuz, yeni/sil/import md, SpritePicker karakter, ofis varsayılan araçları) · Takımlar (akış düzenleyici: adımlar, planApprover, askRole; PUT /workflows) · Bilgi dosyaları" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845" y="367" width="490" height="50" as="geometry"/></mxCell>
        <mxCell id="u-p6" value="&lt;b&gt;McpPanel&lt;/b&gt; — sunucular (katalogdan kur, elle ekle), bağlantıyı dene, araç seçimi, ajan yetkileri, OAuth ile giriş, kullanım raporu (verildi ama kullanılmadı)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845" y="425" width="490" height="44" as="geometry"/></mxCell>
        <mxCell id="u-p7" value="&lt;b&gt;AgentPanel&lt;/b&gt; — frontmatter, composedPrompt, MCP yetkisi (salt okunur), İşler sekmesi (GET /agents/{key}/work) · &lt;b&gt;SettingsPanel&lt;/b&gt; — sağlayıcı girişi (CLI / API anahtarı), modeller, kullanım + &quot;kim ne harcadı&quot; (usage/split), limit eşiği, istem önbelleği ömrü (5m/1h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="845" y="477" width="490" height="66" as="geometry"/></mxCell>

        <mxCell id="u-api" value="&lt;b&gt;api/ — Api ile konuşma katmanı&lt;/b&gt;&lt;br&gt;&lt;b&gt;client.ts&lt;/b&gt; useApiClient: fetch + Bearer JWT, Problem Details → ApiError&lt;br&gt;&lt;b&gt;errors.ts&lt;/b&gt; errorCode → Türkçe metin (title/detail basılmaz)&lt;br&gt;&lt;b&gt;labels.ts&lt;/b&gt; RunStatus/InboxKind/provider etiketleri, maliyet biçimi (≈$)&lt;br&gt;&lt;b&gt;types.ts&lt;/b&gt; → &lt;b&gt;shared/types/api.ts&lt;/b&gt; (npm run gen:api, openapi-typescript; elle yazılmaz)&lt;br&gt;&lt;b&gt;board.ts&lt;/b&gt; Kanban türetimi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="620" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="u-data" value="&lt;b&gt;Veri akışları&lt;/b&gt;&lt;br&gt;&lt;b&gt;SSE&lt;/b&gt; GET /scene/events → feed.ts → world.ts (agent.state, agent.say, agent.goto/home, meet, board.set/move, run.stage, cat, door, clock.set, cafe.special, workflow.set, light, agent.tool, agent.leave/enter)&lt;br&gt;&lt;b&gt;Yoklama&lt;/b&gt; /runs/{id} 2 s (aktif çalışma) · /runs/overview 5 s (rozet, inbox) · /providers 5 s × 3 dk (giriş sonrası) · dil şeridi 60 s&lt;br&gt;&lt;b&gt;Komut&lt;/b&gt; POST /scene/commands (ışık; ikinci tarayıcı da görür)&lt;br&gt;&lt;b&gt;Dosya&lt;/b&gt; POST /attachments (yükle) · GET /runs/{id}/attachments/{name} (Blob)&lt;br&gt;&lt;b&gt;Sprite&lt;/b&gt; public/sprites/*.png + atlas.json (build-sprites.py üretir)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="690" y="590" width="660" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="u-apibox" value="&lt;b&gt;.NET Api :5080&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="790" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ue1" value="REST (JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="u-api" target="u-apibox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ue2" value="SSE + yoklama" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="u-apibox" target="u-data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ue3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="u-panels" target="u-api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="575"/><mxPoint x="350" y="575"/></Array></mxGeometry></mxCell>
        <mxCell id="ue4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="u-data" target="u-scene"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="815" y="570"/><mxPoint x="815" y="300"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================ -->
  <!-- SAYFA 8 — PYTHON RUNTIME -->
  <!-- ============================================================ -->
  <diagram id="p8-python" name="8 · Python ne yapıyor">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="y-title" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;Python runtime — yalnız LLM çağrı katmanı&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Durum tutmaz, veritabanı görmez, iş kuralı bilmez.&lt;/b&gt; Tek işi: {systemPrompt, messages, provider, model, schema?} alıp {text, structured, usage, costUsd} döndürmek. İki ardışık istek birbirini bilmez; geçmiş messages ile gelir. Api kalkışta başlatır (RuntimeSupervisor), kapanışta durdurur. Python kapalıyken .NET derlenir ve ServiceTests koşar (sahte adaptör). scripts/verify.ps1 sınırı denetler." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="y-net" value="&lt;b&gt;.NET Api&lt;/b&gt;&lt;br&gt;PythonAgentRuntimeClient (tek istemci; UI doğrudan konuşmaz)&lt;br&gt;PythonRuntimeProcess (uvicorn alt süreci)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="240" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="y-app" value="&lt;b&gt;runtime/app — FastAPI (127.0.0.1:5090, uvicorn)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="620" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="y-main" value="&lt;b&gt;main.py&lt;/b&gt; — uçlar; iş mantığı yok: isteği adaptöre verir, sonucu olduğu gibi döner. PROVIDERS = {anthropic, openai}; bilinmeyen → 501 runtime.provider_unsupported" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="155" width="590" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="y-e1" value="&lt;b&gt;POST /v1/turn&lt;/b&gt; — tek LLM çağrısı (ajan döngüsü dâhil). Girdi: systemPrompt, messages[], provider, model, effort, schema?, tools?, cwd?, readDirs?, mcpServers? (+ disallowed_tools), agents? (alt ajan), cacheTtl?, progressUrl?. Çıktı: text, structured, usage {input/output/cache}, costUsd, toolUses[], mcpServers[], modelUsage, peakContextTokens. İstemci bağlantıyı keserse tur durdurulur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="209" width="590" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="y-e2" value="&lt;b&gt;GET /v1/models?provider=&lt;/b&gt; — sabit katalog; reachable = giriş var (gerçek çağrı yapılmaz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="297" width="590" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="y-e3" value="&lt;b&gt;GET /v1/auth&lt;/b&gt; — kimlik durumu {loggedIn, account, method: session|apikey|null}; 60 s önbellek · &lt;b&gt;POST /v1/auth/login&lt;/b&gt; — CLI giriş akışını yeni konsolda başlatır (claude auth login / codex login) ya da apikey: doğrular (GET /v1/models) ve credentials.json'a yazar · &lt;b&gt;POST /v1/auth/logout&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="339" width="590" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="y-e4" value="&lt;b&gt;GET /v1/limits?provider=&lt;/b&gt; — kalan kota pencereleri (Anthropic: Claude Code'un /usage ucu, CLI oturumuyla); 90 s önbellek; veremeyen sağlayıcı available=false (5xx dönmez)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="411" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="y-e5" value="&lt;b&gt;GET /v1/usage/local&lt;/b&gt; — makinedeki CLI oturum kayıtlarından kullanım (ofis ajanı vs etkileşimli Claude Code oturumları; &quot;kim ne harcadı&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="463" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="y-e6" value="&lt;b&gt;POST /v1/mcp/probe&lt;/b&gt; (mcp_probe.py) — sunucuyu aç, araçlarını listele, kapat (durumsuz, 45 s); bağlanamamak hata değil sonuçtur (ok=false + neden) · &lt;b&gt;GET /health&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="515" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="y-contracts" value="&lt;b&gt;contracts.py&lt;/b&gt; — pydantic modeller (camelCase alias): TurnRequest, TurnResponse, ModelInfo, AuthStatus, LoginRequest, ProviderLimits, LocalUsage, McpProbeResult" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="567" width="590" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="y-errors" value="&lt;b&gt;Hatalar&lt;/b&gt; (detail.errorCode): runtime.cli_missing 503 · runtime.not_logged_in 503 · runtime.provider_error 502 · runtime.provider_limit (çağrı sırasında kota doldu → Paused) · runtime.provider_unsupported 501 · runtime.tools_unsupported 501 · runtime.mcp_unsupported 501" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="355" y="619" width="590" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="y-canli" value="&lt;b&gt;Canlı bildirim:&lt;/b&gt; progressUrl'e her araç çağrısında {tool, target} ve her mesajın kullanımı {kind: usage} POST edilir (2 s, hata yutulur) — .NET canlı balonu ve kesilen turun harcamasını buradan bilir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="355" y="687" width="590" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="y-prov" value="&lt;b&gt;providers/ — adaptörler (LlmProvider tabanı)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1000" y="120" width="420" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="y-anth" value="&lt;b&gt;anthropic.py&lt;/b&gt;&lt;br&gt;• Claude Agent SDK (claude_agent_sdk) → makinedeki &lt;b&gt;claude.exe&lt;/b&gt; oturumu; arama: CLAUDE_CLI_PATH → %APPDATA%\Claude\claude-code\&amp;lt;sürüm&amp;gt; → PATH&lt;br&gt;• tools, cwd, readDirs (add_dirs), MCP (strict_mcp_config, disallowed_tools), agents (alt ajan) hepsi .NET'ten gelir; runtime yalnız eşler&lt;br&gt;• &lt;b&gt;_guard&lt;/b&gt; (can_use_tool): Write/Edit yalnız cwd içi; Bash'te mutlak yol/~/.. ret; MCP araçları izin listesi dışında ret; Agent aracı yalnız verilen alt ajanla (yerleşik Explore/general-purpose ret)&lt;br&gt;• her araç çağrısı ve mesaj kullanımı progressUrl'e&lt;br&gt;• schema → yapısal çıktı; effort low|medium|high|max&lt;br&gt;• cacheTtl → FORCE_PROMPT_CACHING_5M / ENABLE_PROMPT_CACHING_1H; 5 dk yazma payı ayrı ölçülür&lt;br&gt;• API anahtarı kayıtlıysa ANTHROPIC_API_KEY ortamla SDK'ya (fatura Console'a, kota penceresi yok)&lt;br&gt;• usage, costUsd, modelUsage (alt ajan payı), peakContextTokens (en büyük tek çağrı)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1015" y="155" width="390" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="y-oai" value="&lt;b&gt;openai.py&lt;/b&gt; — iki yol, öncelik sırasıyla&lt;br&gt;1. &lt;b&gt;API anahtarı&lt;/b&gt;: Responses API doğrudan (httpx); araçlı istek → 501 tools_unsupported&lt;br&gt;2. &lt;b&gt;ChatGPT aboneliği&lt;/b&gt;: Codex CLI &lt;code&gt;codex exec --json --ephemeral -C cwd&lt;/code&gt;; araçlıysa --sandbox workspace-write, değilse read-only; --output-schema; sistem promptu &quot;# Sistem talimatı&quot; olarak başa&lt;br&gt;• MCP ve alt ajan bağlanmadı (501 mcp_unsupported) · canlı araç akışı yok (tur sonunda) · kalan kullanım yok&lt;br&gt;• maliyet liste fiyatından eşdeğer (PRICE_PER_M) · katalog OPENAI_MODELS ile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1015" y="465" width="390" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="y-base" value="&lt;b&gt;base.py&lt;/b&gt; LlmProvider: complete(), models(), auth(), login(), logout(), limits() · nvidia/ollama sonra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=6;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1015" y="675" width="390" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="y-cred" value="&lt;b&gt;credentials.py — kimlik önceliği&lt;/b&gt;&lt;br&gt;1. ortam değişkeni ANTHROPIC_API_KEY / OPENAI_API_KEY&lt;br&gt;2. %USERPROFILE%\.mrhobist-aiteam\credentials.json (AITEAM_CREDENTIALS_FILE ile değişir)&lt;br&gt;3. CLI oturumu (claude login / codex login) — Windows kullanıcısına bağlı&lt;br&gt;Anahtar hiçbir yanıta ve günlüğe yazılmaz; UI maskeli sonu görür. Bu dosyayı runtime yazar: iş durumu değil kimlik bilgisi (§1 istisnası, bilinçli)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="260" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="y-not" value="&lt;b&gt;Burada OLMAYAN şeyler (pazarlıksız)&lt;/b&gt;&lt;br&gt;✗ if role == … dallanması&lt;br&gt;✗ tur sayacı, faz, iş akışı, görev kavramı&lt;br&gt;✗ dosya yazma (kod yazan modeldir, cwd içinde)&lt;br&gt;✗ veritabanı, durum&lt;br&gt;✗ araç / MCP / alt ajan seçimi (hepsi .NET'te: ToolAccess, McpService, Explorer)&lt;br&gt;✗ OAuth akışı (McpOAuthService .NET'te)&lt;br&gt;Sızarsa: mantık iki dile bölünür, döngü Python'suz test edilemez." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="260" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="y-claude" value="&lt;b&gt;claude.exe&lt;/b&gt; (Claude Code CLI)&lt;br&gt;OAuth oturumu · /usage ucu · oturum kayıtları" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="780" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="y-codex" value="&lt;b&gt;codex&lt;/b&gt; (Codex CLI)&lt;br&gt;ChatGPT oturumu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="780" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="y-mcps" value="&lt;b&gt;MCP sunucuları&lt;/b&gt; (stdio: npx @playwright/mcp → Edge · http/sse uzak: Bearer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="780" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="y-cloud" value="&lt;b&gt;Anthropic API · OpenAI API&lt;/b&gt; (makine dışına çıkan tek çağrı; hedef run_turn'e yazılır: anthropic | openai)" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="870" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="y-tests" value="&lt;b&gt;tests/&lt;/b&gt; test_contracts · test_anthropic_provider · test_openai_provider (pytest, respx ile HTTP sahteleme)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="880" width="620" height="40" as="geometry"/></mxCell>

        <mxCell id="ye1" value="HTTP /v1/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="y-net" target="y-app"><mxGeometry relative="1" as="geometry"/></mxCell>
