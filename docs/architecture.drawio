  <!-- SAYFA 4 — EKİP VE İŞ AKIŞLARI -->
  <!-- ============================================================ -->
  <diagram id="p4-team" name="4 · Ekip ve iş akışları">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="k-title" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px&quot;&gt;Ekip tanımı ve iş akışları&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Takım = iş akışı. Ajanlar tek havuzdur (config/agents/*.md); proje bir akış seçer, akış her adımda bir ajanı çağırır. Ekip açıktır: zorunlu rol yok, UI'daki Ekip panelinden ajan/akış eklenir." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="70" as="geometry"/>
        </mxCell>

        <!-- Ajan havuzu -->
        <mxCell id="k-pool" value="&lt;b&gt;Ajan havuzu — config/agents/*.md&lt;/b&gt; (frontmatter: name · summary · office_roles · provider · model · effort · includes · can_ask; gövde = sistem promptu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1000" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="k-a1" value="&lt;b&gt;Analist&lt;/b&gt; (analyst)&lt;br&gt;Brief'i çözer, mimariyi kurar, bağımlılık sıralı görev grafiği + kurallar (Spec)&lt;br&gt;ofis: pm, arch, res · effort low&lt;br&gt;includes: mimari-kurallar&lt;br&gt;can_ask: manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="150" width="155" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="k-a2" value="&lt;b&gt;Tasarımcı&lt;/b&gt; (designer)&lt;br&gt;Kullanıcıya dokunan yüzeyleri ve akışı belirler; kod yazmaz, rehberlik notu&lt;br&gt;ofis: designer&lt;br&gt;includes: tasarim-ilkeleri&lt;br&gt;can_ask: manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="218" y="150" width="155" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="k-a3" value="&lt;b&gt;Developer&lt;/b&gt; (developer)&lt;br&gt;Görevi kodlar: dosya yazar, build/test koşar; red gelirse düzeltir; takılırsa blocked&lt;br&gt;ofis: dev · araç: tam&lt;br&gt;includes: mimari-kurallar, kodlama-standartlari&lt;br&gt;can_ask: manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="381" y="150" width="155" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="k-a4" value="&lt;b&gt;Testçi&lt;/b&gt; (tester)&lt;br&gt;Kodu okur, testleri fiilen koşar (test dosyası yazabilir, uygulama kodunu değiştirmez); kabul / gerekçeli red&lt;br&gt;ofis: qa, gate · araç: tam&lt;br&gt;includes: kodlama-standartlari&lt;br&gt;can_ask: manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="544" y="150" width="155" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="k-a5" value="&lt;b&gt;Manager&lt;/b&gt; (manager)&lt;br&gt;Altı şapkalı karar verici: son onay kapısı; ajan sorularını cevaplar (escalate edebilir)&lt;br&gt;ofis: gate&lt;br&gt;includes: karar-ilkeleri" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="707" y="150" width="155" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="k-a6" value="&lt;b&gt;Organizatör&lt;/b&gt; (organizer)&lt;br&gt;Adım geçişinde devir notu yazar (yalnız implement atamasında); ucuz model&lt;br&gt;ofis: ops&lt;br&gt;anthropic · claude-haiku-4-5 · effort low" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="150" width="155" height="175" as="geometry"/>
        </mxCell>

