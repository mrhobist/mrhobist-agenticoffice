        <mxCell id="k-w2s1" value="&lt;b&gt;Analiz&lt;/b&gt;&lt;br&gt;analyze · analyst" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
