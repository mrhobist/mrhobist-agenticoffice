          <mxGeometry x="640" y="670" width="250" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="l-start" target="l-run1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le1b" value="politika / bütçe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;strokeColor=#b85450;" edge="1" parent="1" source="l-start" target="l-pol"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le2" value="Spec hazır" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="l-run1" target="l-aa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le3" value="revise {note} → analiz yeniden (geçmişle)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="l-aa" target="l-run1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="150"/><mxPoint x="445" y="150"/></Array></mxGeometry></mxCell>
        <mxCell id="le4" value="approve / auto → board.set" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="l-aa" target="l-run2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="l-run2" target="l-done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le6" value="soru" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="l-run2" target="l-ai"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le7" value="answer {choice} → retry/skip" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="l-ai" target="l-run2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="545"/><mxPoint x="600" y="395"/></Array></mxGeometry></mxCell>
        <mxCell id="le8" value="limit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="l-run2" target="l-paused"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="395"/></Array></mxGeometry></mxCell>
        <mxCell id="le9" value="pencere sıfırlandı / retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="l-paused" target="l-run2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="470"/><mxPoint x="700" y="470"/></Array></mxGeometry></mxCell>
        <mxCell id="le10" value="hata / çökme / bütçe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;strokeColor=#b85450;exitX=1;exitY=0.75;entryX=0;entryY=0.3;" edge="1" parent="1" source="l-run2" target="l-fail"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="412"/><mxPoint x="960" y="530"/></Array></mxGeometry></mxCell>
        <mxCell id="le11" value="retry → kaldığı adımdan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="l-fail" target="l-run2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="580"/><mxPoint x="920" y="395"/></Array></mxGeometry></mxCell>
        <mxCell id="le12" value="cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;strokeColor=#b85450;" edge="1" parent="1" source="l-ai" target="l-cancel"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le13" value="cancel (Running/AwaitingApproval/Paused/Failed/…)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;strokeColor=#b85450;" edge="1" parent="1" source="l-fail" target="l-cancel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="705"/></Array></mxGeometry></mxCell>
        <mxCell id="le14" value="retry → Running ya da AwaitingApproval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="l-cancel" target="l-aa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="705"/><mxPoint x="300" y="235"/></Array></mxGeometry></mxCell>

        <mxCell id="l-loop" value="&lt;b&gt;Bir adımın iç döngüsü (faz kayıtları — run_phase)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=13;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1300" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="l-p1" value="görev &lt;b&gt;queued&lt;/b&gt;&lt;br&gt;(dependsOn done, boş kopya yok)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="l-p2" value="&lt;b&gt;handoff&lt;/b&gt; (handoffRole varsa, yalnız implement)&lt;br&gt;devir notu → run_message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="860" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="l-p3" value="&lt;b&gt;Started&lt;/b&gt; (adım, ajan, worker, tur)&lt;br&gt;LimitGuard + bütçe → AgentCaller → runtime /v1/turn&lt;br&gt;canlı: agent.tool balonları, kullanım" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="860" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="l-p4" value="&lt;b&gt;Done&lt;/b&gt; → sonraki adım (anlık görüntü alınır)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="830" width="190" height="40" as="geometry"/></mxCell>
        <mxCell id="l-p5" value="&lt;b&gt;Rejected&lt;/b&gt; → önceki üretici adım (feedback notu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="880" width="190" height="40" as="geometry"/></mxCell>
        <mxCell id="l-p6" value="&lt;b&gt;Failed&lt;/b&gt; → aynı adım (cause: agent | limit | cancelled | interrupted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="930" width="190" height="50" as="geometry"/></mxCell>
        <mxCell id="l-p7" value="&lt;b&gt;Skipped&lt;/b&gt; (ajan: user) → sonraki adım; yalnız kullanıcı &quot;skip&quot; deyince" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="880" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="l-p8" value="tur = adımda bitmiş deneme + 1 · kapı başına maxReviewRounds → aşınca AwaitingInput · limit/iptal/kesinti fazları sayılmaz&lt;br&gt;Taşınan görev geçmişi (red döngüsünde) CompactionBudget ile kırpılır (4 mesaj / 12k token; tek ajanlı akışta uyur)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="935" width="680" height="70" as="geometry"/></mxCell>
        <mxCell id="lp1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="l-p1" target="l-p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lp2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="l-p2" target="l-p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lp3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="l-p3" target="l-p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lp4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="l-p3" target="l-p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lp5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="l-p3" target="l-p6"><mxGeometry relative="1" as="geometry"/></mxCell>
