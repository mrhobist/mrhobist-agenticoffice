        </mxCell>
        <mxCell id="k-w2s2" value="&lt;b&gt;Tasarım&lt;/b&gt;&lt;br&gt;design · designer&lt;br&gt;→ guidance, decisions[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
