{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "ui",
        "run",
        "dev"
      ],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/MrHobist.AITeam.Api",
        "--no-launch-profile"
      ],
      "port": 5080,
      "url": "http://127.0.0.1:5080"
    },
    {
      "name": "runtime",
      "runtimeExecutable": "runtime/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-u",
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "5090",
        "--app-dir",
        "runtime"
      ],
      "port": 5090,
      "url": "http://127.0.0.1:5090"
    }
  ]
}
